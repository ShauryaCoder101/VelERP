# Copy to .env and fill in. Never commit .env — it is gitignored.
# Everything below must also be set in Vercel, for BOTH Production and Preview.

# ---- Database (Supabase) ----
DATABASE_URL=
DIRECT_URL=

# ---- Mail: password-reset OTPs ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- S3: documents (bills, cost sheets, avatars) ----
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=            # optional, only for a custom domain

# ---- Cloudflare R2: bulk event media ----
# Optional. Leave blank and event media stays on S3, exactly as before.
# The bucket must be private, and needs a CORS rule allowing PUT from your
# app's origin or browser uploads fail. See STORAGE.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=            # optional, only for a custom domain

# ---- S3 Glacier Deep Archive: cold originals ----
# Optional. An ordinary S3 bucket — Deep Archive is a per-object storage class,
# not a bucket type. Objects are written cold directly by the rclone script,
# so no lifecycle rule is needed.
S3_ARCHIVE_BUCKET=
ARCHIVE_AFTER_DAYS=60

# ---- Client share links ----
# Strongly recommended in production. Without it a key is derived from other
# server secrets, so rotating your S3 key invalidates every live client link.
#
# Links run 2-30 days and are stateless, so an individual link cannot be
# revoked early. Rotating this value is the emergency stop — it kills every
# outstanding link at once.
SHARE_LINK_SECRET=
