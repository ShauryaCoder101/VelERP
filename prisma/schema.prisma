generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  MANAGING_DIRECTOR
  HEAD_OF_OPERATIONS
  HEAD_OF_SPECIAL_PROJECTS
  GROWTH_PARTNER
  OPERATIONS_TEAM_MEMBER
  RESEARCH_AND_DEVELOPMENT_TEAM_MEMBER
  INTERN
  ASSISTANT
  FREELANCER
  ACCOUNTANT
  PHOTOGRAPHER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum PaymentMode {
  CREDIT_CARD
  DEBIT_CARD
  UPI
  NOTA
}

enum Phase {
  IDEATION
  PITCHING
  BIDDING
  PREPARATION
  ONGOING
  FINISHED
}

model User {
  id          String   @id @default(uuid())
  uid         String   @unique
  name        String
  email       String   @unique
  passwordHash String
  designation String
  role        RoleName
  team        String?
  avatarUrl   String?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  onboardedVendors Vendor[]  @relation("VendorOnboardedBy")
  onboardedArtists Artist[]  @relation("ArtistOnboardedBy")
  assignedTasks    Task[]    @relation("TaskAssignedBy")
  receivedTasks    Task[]    @relation("TaskAssignedTo")
  ratings          Rating[]
  sessions         Session[]
  expenseClaims    ExpenseClaim[]
  uploads          Upload[]
  eventTeamMembers EventTeamMember[] @relation("EventTeamMembers")
  bdCalls          BdCall[]          @relation("BdCallAddedBy")
  notifications    Notification[]    @relation("NotificationActor")
  assignedLeads    Lead[]            @relation("LeadAssignedTo")
  assignedDeals    Deal[]            @relation("DealAssignedTo")
  sanctions        EventSanction[]   @relation("UserSanctions")
  mediaShares      MediaShare[]      @relation("MediaShareCreatedBy")

  photographerProfile  PhotographerProfile?  @relation("PhotographerProfileUser")
  createdPhotographers PhotographerProfile[] @relation("PhotographerProfileCreatedBy")
  photographerAccess   PhotographerEventAccess[] @relation("PhotographerAccessPhotographer")
  grantedPhotographerAccess PhotographerEventAccess[] @relation("PhotographerAccessGrantedBy")
  revokedPhotographerAccess PhotographerEventAccess[] @relation("PhotographerAccessRevokedBy")
  multipartSessions    MultipartSession[]

  uploadLinks         UploadLink[]   @relation("UploadLinkPhotographer")
  revokedUploadLinks  UploadLink[]   @relation("UploadLinkRevokedBy")
  createdMediaFolders MediaFolder[]  @relation("MediaFolderCreatedBy")
  uploadCharges       UploadCharge[]
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Event {
  id              String   @id @default(uuid())
  companyName     String
  eventName       String
  pocName         String
  pocPhone        String
  phase           Phase    @default(IDEATION)
  fromDate        DateTime
  toDate          DateTime
  costSheetUrl    String?
  closingSheetUrl String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendors     EventVendor[]
  artists     EventArtist[]
  teamMembers EventTeamMember[]
  uploads     Upload[]
  claims      ExpenseClaim[]
  finances    EventVendorFinance[]
  sanctions   EventSanction[]
  shares      MediaShare[]
  photographerAccess PhotographerEventAccess[]
  uploadLinks        UploadLink[]
  mediaFolders       MediaFolder[]
}

model Vendor {
  id           String   @id @default(uuid())
  companyName  String
  email        String?
  phone        String
  work         String
  location     String?
  gstin        String?
  panCard      String?
  pocName      String?
  status       Status   @default(INACTIVE)
  currentEvent String?
  onboardedAt  DateTime @default(now())
  onboardedBy  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  onboardedByUser User                @relation("VendorOnboardedBy", fields: [onboardedBy], references: [id])
  ratings         Rating[]
  events          EventVendor[]
  finances        EventVendorFinance[]
}

model Artist {
  id           String   @id @default(uuid())
  name         String
  phone        String
  category     String
  location     String?
  socialLink   String?
  status       Status   @default(INACTIVE)
  currentEvent String?
  lastEvent    String?
  onboardedAt  DateTime @default(now())
  onboardedBy  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  onboardedByUser User     @relation("ArtistOnboardedBy", fields: [onboardedBy], references: [id])
  ratings         Rating[]
  events          EventArtist[]
}

model Rating {
  id        String   @id @default(uuid())
  rating    Int
  remarks   String?
  createdAt DateTime @default(now())

  vendorId  String?
  artistId  String?
  userId    String

  vendor    Vendor?  @relation(fields: [vendorId], references: [id])
  artist    Artist?  @relation(fields: [artistId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model EventVendor {
  eventId  String
  vendorId String

  event  Event  @relation(fields: [eventId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@id([eventId, vendorId])
}

model EventVendorFinance {
  id            String      @id @default(uuid())
  eventId       String
  vendorId      String
  quotedAmount  Float       @default(0)
  advancePaid   Float       @default(0)
  totalPaid     Float       @default(0)
  closed        Boolean     @default(false)
  paymentMode   PaymentMode @default(NOTA)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  event   Event  @relation(fields: [eventId], references: [id])
  vendor  Vendor @relation(fields: [vendorId], references: [id])

  @@unique([eventId, vendorId])
}

model EventSanction {
  id               String   @id @default(uuid())
  eventId          String
  userId           String
  sanctionedAmount Float    @default(0)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation("UserSanctions", fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model EventArtist {
  eventId  String
  artistId String

  event  Event  @relation(fields: [eventId], references: [id])
  artist Artist @relation(fields: [artistId], references: [id])

  @@id([eventId, artistId])
}

model EventTeamMember {
  eventId String
  userId  String

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation("EventTeamMembers", fields: [userId], references: [id])

  @@id([eventId, userId])
}

model ExpenseClaim {
  id         String         @id @default(uuid())
  userId     String
  eventId    String?
  status     Status         @default(INACTIVE)
  submittedAt DateTime      @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user       User           @relation(fields: [userId], references: [id])
  event      Event?         @relation(fields: [eventId], references: [id])
  items      ExpenseItem[]
  attachments ExpenseAttachment[]
}

model ExpenseItem {
  id        String   @id @default(uuid())
  claimId   String
  eventName String
  location  String
  type      String
  date      DateTime
  amount    Float

  claim     ExpenseClaim @relation(fields: [claimId], references: [id])
}

model ExpenseAttachment {
  id        String   @id @default(uuid())
  claimId   String
  fileUrl   String
  fileType  String
  createdAt DateTime @default(now())

  claim     ExpenseClaim @relation(fields: [claimId], references: [id])
}

model Upload {
  id        String   @id @default(uuid())
  eventId   String
  fileUrl   String
  fileType  String
  uploadedBy String
  // Nullable because rows written before the column existed have no size on
  // record; scripts/backfill-upload-sizes.mts fills them in from storage.
  sizeBytes BigInt?
  /**
   * Set when the file came in through an open upload link rather than a login.
   * uploadedBy stays the FIRM's account either way — the quota, the grant and
   * the folder are all the firm's — so this is the only thing that can say
   * WHICH of the firm's people actually sent it.
   */
  contributorId String?
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [uploadedBy], references: [id])
  /**
   * SetNull, not Cascade: a contributor record going away must never silently
   * delete the files they uploaded — those belong to the event.
   */
  contributor UploadContributor? @relation(fields: [contributorId], references: [id], onDelete: SetNull)

  @@index([contributorId])
  /**
   * This table had no index but its primary key, and three endpoints an
   * anonymous link holder reaches read it BEFORE any quota, ceiling or storage
   * check — the folder listing (DISTINCT on a regexp over every row of the
   * event), registration's dedupe, and the multipart key check. On an instance
   * holding hundreds of gigabytes of client media across 28 events that is a
   * sequential scan per request, and the ERP's dashboard, tasks and sales pages
   * share the instance, so the cost lands on the whole product rather than on
   * uploads. All three are scoped to one event — the key check is passed its
   * eventId for exactly that reason — so one composite index serves them, and
   * it covers the plain `where: { eventId }` reads (the gallery, the ZIP, the
   * per-link stats) as a bonus.
   */
  @@index([eventId, fileUrl])
}

model Task {
  id         String   @id @default(uuid())
  title      String
  notes      String?
  dueDate    DateTime?
  assignedBy String
  assignedTo String
  createdAt  DateTime @default(now())

  assignedByUser User @relation("TaskAssignedBy", fields: [assignedBy], references: [id])
  assignedToUser User @relation("TaskAssignedTo", fields: [assignedTo], references: [id])
}

enum BdStatus {
  FOLLOWUP
  LEAD
  DORMANT
  ACTIVE
}

model BdCall {
  id          String   @id @default(uuid())
  company     String
  pocName     String
  pocPhone    String
  pocEmail    String?
  callDate    DateTime
  remarks     String?
  status      BdStatus @default(ACTIVE)
  addedBy     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  addedByUser User @relation("BdCallAddedBy", fields: [addedBy], references: [id])
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  COLD_CALL
  EVENT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
}

enum DealStage {
  QUALIFICATION
  NEEDS_ANALYSIS
  VALUE_PROPOSITION
  IDENTIFY_DECISION_MAKERS
  PROPOSAL_PRICE_QUOTE
  NEGOTIATION_REVIEW
  CLOSED_WON
  CLOSED_LOST
}

model Lead {
  id          String     @id @default(uuid())
  name        String
  company     String
  email       String?
  phone       String?
  address     String?
  source      LeadSource @default(OTHER)
  status      LeadStatus @default(NEW)
  notes       String?
  assignedTo  String?
  createdBy   String
  convertedDealId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assignedToUser User? @relation("LeadAssignedTo", fields: [assignedTo], references: [id])
}

model SalesContact {
  id          String   @id @default(uuid())
  name        String
  email       String?
  phone       String?
  company     String?
  designation String?
  accountId   String?
  notes       String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account? @relation(fields: [accountId], references: [id])
}

model Account {
  id          String   @id @default(uuid())
  companyName String
  industry    String?
  phone       String?
  email       String?
  website     String?
  address     String?
  notes       String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts SalesContact[]
  deals    Deal[]
}

model Deal {
  id                String    @id @default(uuid())
  dealName          String
  accountId         String?
  stage             DealStage @default(QUALIFICATION)
  amount            Float     @default(0)
  expectedCloseDate DateTime?
  notes             String?
  assignedTo        String?
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  account        Account? @relation(fields: [accountId], references: [id])
  assignedToUser User?    @relation("DealAssignedTo", fields: [assignedTo], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  body      String
  actorId   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  actor User @relation("NotificationActor", fields: [actorId], references: [id])
}

/// A client delivery link. Tokens stay self-verifying, but recording them here
/// is what makes them listable, revocable, and countable — without this, staff
/// cannot see an existing link and simply mint another.
model MediaShare {
  id           String    @id @default(uuid())
  eventId      String
  folder       String?
  token        String    @unique
  createdBy    String
  expiresAt    DateTime
  revokedAt    DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  remindedAt   DateTime?
  createdAt    DateTime  @default(now())

  event   Event @relation(fields: [eventId], references: [id])
  creator User  @relation("MediaShareCreatedBy", fields: [createdBy], references: [id])

  @@index([eventId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Third-party photographers.
//
// A photographer is an ordinary User with role PHOTOGRAPHER, so login, session
// and deactivation all work unchanged. These two tables add the only things a
// photographer needs that an employee does not: a spend ceiling, and an
// explicit list of the events they may touch.
// ---------------------------------------------------------------------------

model PhotographerProfile {
  userId String @id

  /**
   * Hard ceiling on what this account may ever upload. 1 TB.
   */
  quotaBytes BigInt @default(1000000000000)

  /**
   * Bytes AUTHORISED, not bytes written: incremented when an upload URL is
   * signed, not when the object lands. Signing is the only moment we control,
   * so it is the only place a limit can actually bite.
   * Every charge is accounted for afterwards, so an authorisation nobody spent
   * does not become a permanent debit: a multipart upload refunds on
   * OPEN -> ABORTED, and a single-PUT original or derivative refunds through
   * the UploadCharge ledger once its key is known not to be in storage.
   */
  allocatedBytes BigInt @default(0)

  /**
   * The one folder inside every event that holds everything this firm uploads,
   * from the main login and from every open link. Unique because it is a
   * namespace: two firms sharing a folder name would share a key prefix, and
   * the "is this key inside my root?" check that confines a contributor would
   * then let one firm's link write into the other's folder.
   * Nullable only for the moment between a profile being created and the name
   * being derived; firmFolderName() in lib/upload-links.ts fills it in on first
   * use and the migration backfilled every row that existed.
   */
  folderName String? @unique

  /**
   * When this firm's opportunistic housekeeping last ran — the charge sweep at
   * presign and the multipart sweep at create share it.
   * Both sit on the critical path of starting a file, and both are reachable by
   * anyone holding a forwarded upload link, so a flood that is about to be
   * refused would otherwise pay for a sweep per refused request. A sweep is
   * claimed by moving this forward in one conditional UPDATE (see
   * claimSweepSlot in lib/photographers.ts); only the writer that moves it
   * sweeps, so the work is bounded at one pass per firm per minute however many
   * requests arrive. Null means "never swept", which always wins the claim.
   */
  lastSweptAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())

  /**
   * Cascade: the profile is an attribute of the account, not a record of its
   * own. Leaving it RESTRICT would make deleting a photographer impossible.
   */
  user    User  @relation("PhotographerProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  creator User? @relation("PhotographerProfileCreatedBy", fields: [createdById], references: [id])
}

model PhotographerEventAccess {
  id             String    @id @default(uuid())
  photographerId String
  eventId        String
  grantedById    String
  grantedAt      DateTime  @default(now())
  revokedAt      DateTime?
  revokedById    String?

  /**
   * Cascade on the two FKs that define the grant. Revokes are soft — the row
   * survives forever — so under RESTRICT a single grant would permanently block
   * deleting the event or the photographer. A grant to a deleted event, or held
   * by a deleted account, means nothing, so it goes with it. grantedBy and
   * revokedBy stay as they are: those are audit trail, and an employee leaving
   * must not quietly erase who handed out access.
   */
  photographer User  @relation("PhotographerAccessPhotographer", fields: [photographerId], references: [id], onDelete: Cascade)
  grantedBy    User  @relation("PhotographerAccessGrantedBy", fields: [grantedById], references: [id])
  revokedBy    User? @relation("PhotographerAccessRevokedBy", fields: [revokedById], references: [id])
  event        Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /**
   * One row per pair, forever: re-granting clears revokedAt on the row that is
   * already there rather than stacking a second grant, so "is it revoked?" has
   * exactly one answer.
   */
  @@unique([photographerId, eventId])
  @@index([eventId])
}

/**
 * The authoritative record of an open multipart upload.
 * The signed ticket the client carries is tamper-proof but replayable: it is a
 * bearer value with a 7 day life, and R2's AbortMultipartUpload is idempotent,
 * so "abort succeeded" is not evidence that anything was actually discarded.
 * Refunding a photographer's quota on that evidence let the same bytes be
 * handed back on every call, which made the 1 TB ceiling decorative.
 * So state lives here instead. OPEN -> COMPLETED and OPEN -> ABORTED are single
 * conditional UPDATEs, and the refund is attached to the transition rather than
 * to the storage call: exactly one abort can ever observe OPEN, so exactly one
 * refund can ever happen.
 */
model MultipartSession {
  /**
   * The S3/R2 upload id. Unique per upload, so it is the natural key.
   */
  uploadId String @id

  userId  String
  key     String
  eventId String

  /**
   * Which storage profile the upload was opened against ("media" | "document").
   * Needed because the janitor has only this row to work from and must abort
   * against the right bucket.
   */
  purpose String @default("media")

  fileSize BigInt
  partSize BigInt

  /**
   * Quota reserved at create time. 0 for employees, who have no ceiling.
   */
  bytesCharged BigInt @default(0)

  /**
   * Which contributor opened this session, or null for a logged-in uploader.
   * sign / complete / abort all require the caller to present the SAME value:
   * the ticket only proves which firm you are, and every contributor of a firm
   * shares that id, so without this one contributor could finish or abort
   * another's upload. Deliberately a bare column with no foreign key — it is an
   * equality check against a value the server already holds, and the session
   * table is swept by a janitor rather than kept in step with anything.
   */
  contributorId String?

  /**
   * Which upload link this session came through, or null for the firm's main
   * login and for employees. The pending-bytes ceiling has a per-LINK tier
   * between the per-contributor one and the firm's: a link is a bearer URL that
   * may have been forwarded to a whole crew, so one link's crew must not be
   * able to spend what the firm's other links need. Deriving it by joining
   * every contributor of the link would be an IN list of up to
   * MAX_CONTRIBUTORS_PER_LINK inside the charging transaction, on the critical
   * path of every large file — so it is stamped on the row instead. Bare
   * column, no foreign key, for the same reasons as contributorId.
   */
  linkId String?

  /**
   * OPEN | COMPLETED | ABORTED. Only OPEN may be claimed.
   */
  state String @default("OPEN")

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  /**
   * The last time this session was handed part signatures — set at create and
   * refreshed by every successful `sign`. It is what makes "this upload is
   * dead" provable rather than guessed: after it plus PART_EXPIRY no URL this
   * session ever received is still valid, so the upload cannot advance without
   * asking for more, which would move this column. The firm-wide pending-bytes
   * cap would otherwise ration everybody for the seven days a closed browser
   * tab's session sat OPEN.
   * Null for rows written before the column existed; readers COALESCE to
   * createdAt, which is what the value would have been.
   */
  lastActivityAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * The janitor's query: OPEN rows whose activity stopped before a cutoff.
   */
  @@index([state, lastActivityAt])
  @@index([state, createdAt])
  /**
   * The per-link pending-bytes ceiling, read inside the charging transaction.
   */
  @@index([linkId, state])
  /**
   * "Does another upload hold this key?", which /api/uploads/multipart create
   * asks before it opens anything. COMPLETED rows are never deleted, so without
   * an index that lookup reads every OPEN and COMPLETED row the firm has ever
   * written and gets permanently more expensive with every legitimate upload.
   */
  @@index([key, state])
  /**
   * The pending-bytes tiers, which are all "this firm's OPEN sessions" narrowed
   * by contributorId or linkId. Nothing indexed userId at all, so each tier
   * aggregate scanned the table — once inside the charging transaction, and now
   * once again in the cheap pre-check that sheds a flood before storage is
   * touched.
   */
  @@index([userId, state])
}

/**
 * One quota authorisation for one object key, so an authorisation nobody spent
 * can be found again and given back.
 * /api/uploads/presign charges a photographer for the single-PUT original and
 * for each thumb/preview slot it signs, BEFORE any of those objects exist —
 * that is the only moment a ceiling can be enforced. Nothing used to revisit
 * those charges: a PUT that never happened, or a tab closed between presign and
 * registration, debited the firm forever. Open upload links made that reachable
 * by anyone holding a forwarded URL, so a scripted loop of presign calls could
 * pin a firm's whole 1 TB with zero bytes stored.
 * A row is settled exactly once, and the settlement says which way it went:
 * "registered" — the file was registered, so the bytes are real;
 * "landed"     — the object is in storage though no row claimed it; the
 * charge stands, because refunding stored bytes would be a free
 * upload for anyone who PUTs without registering;
 * "refunded"   — the object is provably not in storage and the bytes went back.
 * Employees have no ceiling and get no rows.
 */
model UploadCharge {
  id      String @id @default(uuid())
  userId  String
  eventId String

  /**
   * Which contributor's presign took these bytes, or null for the firm's main
   * login. Every contributor of a firm presents the FIRM's user id, so userId
   * alone cannot tell them apart: without this the unsettled-bytes ceiling
   * could only ever be firm-wide, and one abusing link holder would ration the
   * firm's own photographers. It is also the only thing that can answer "which
   * link burned this quota" after the fact, so the right link can be revoked
   * instead of waiting out the sweep. Deliberately a bare column with no
   * foreign key, matching MultipartSession.contributorId: it is an equality
   * filter on a value the server already holds, and a revoked contributor's
   * charges must stay readable.
   */
  contributorId String?

  /**
   * Which upload link the contributor was holding, or null for the firm's main
   * login. The unsettled-bytes ceiling has a per-LINK tier between the
   * per-contributor one and the firm's: one link may have been forwarded to a
   * whole crew, and that crew must not be able to spend what the firm's other
   * links need. Stamped on the row rather than joined through
   * UploadContributor, because the ceiling is read inside the charging
   * transaction on the critical path of every single file.
   */
  linkId String?

  /**
   * The object key the bytes were authorised for — thumb and preview included.
   */
  key   String
  bytes BigInt

  createdAt DateTime @default(now())

  /**
   * Null means unsettled. The transition null -> now() is the claim that
   * authorises a refund, so exactly one writer can ever pay it.
   */
  settledAt DateTime?

  /**
   * "registered" | "landed" | "refunded"; null while unsettled.
   */
  outcome String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * The per-firm sweep, and the all-links tier of the unsettled-bytes ceiling
   * (every unsettled row of the firm, filtered on linkId IS NOT NULL).
   */
  @@index([userId, settledAt])
  /**
   * The two tiers that filter on contributorId: the per-contributor one
   * (contributorId = X) and the firm's main-login pool (contributorId IS NULL).
   * Neither is covered by [userId, settledAt], so the main login's own ceiling —
   * the one that exists precisely so link traffic cannot ration the firm — was
   * read by scanning every unsettled row the firm's links had written, inside
   * the PhotographerProfile row lock that serialises the firm's charges.
   */
  @@index([userId, contributorId, settledAt])
  /**
   * The per-link unsettled-bytes ceiling.
   */
  @@index([linkId, settledAt])
  /**
   * The all-firms daily sweep: unsettled rows, oldest first.
   */
  @@index([settledAt, createdAt])
  /**
   * Registration settles by key.
   */
  @@index([key])
}

// ---------------------------------------------------------------------------
// Open upload links.
//
// A photographer firm has ONE login and dozens of people spread over several
// states; issuing each of them an account is not happening. So the firm mints a
// Drive-style link instead: no password, no session, just a URL. Everything
// that arrives through it is still the FIRM's — the firm's event grant, the
// firm's 1 TB, the firm's folder — which is what keeps the ceiling honest no
// matter how many links exist.
// ---------------------------------------------------------------------------

model UploadLink {
  id String @id @default(uuid())

  /**
   * Stored raw, not hashed, unlike a password: the firm has to be able to come
   * back and copy the link again, and a link IS its token — there is nothing
   * else to present. 24 random bytes is 192 bits, far past guessing.
   */
  token String @unique

  /**
   * The firm's main login. Quota, grant and folder all hang off this user.
   */
  photographerId String
  eventId        String

  label     String?
  expiresAt DateTime

  /**
   * Soft revoke, and staff-only — the same rule as a client share link. A firm
   * that could close its own link could also hide what came in through it.
   */
  revokedAt   DateTime?
  revokedById String?

  createdAt DateTime @default(now())

  /**
   * Last time the link resolved for anyone. Cheap liveness for the staff view.
   */
  lastUsedAt DateTime?

  /**
   * Cascade on the two FKs that define the link; a link to a deleted event, or
   * one held by a deleted account, means nothing. revokedBy is audit trail and
   * survives the employee leaving.
   */
  photographer User  @relation("UploadLinkPhotographer", fields: [photographerId], references: [id], onDelete: Cascade)
  event        Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  revokedBy    User? @relation("UploadLinkRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  contributors UploadContributor[]

  @@index([photographerId])
  @@index([eventId])
}

/// One person who has used an open link. Created the first time they open it,
/// when they are asked their name and nothing else.
model UploadContributor {
  id     String @id @default(uuid())
  linkId String

  /**
   * What they typed, trimmed, for display and attribution.
   */
  name String

  /**
   * The folder their uploads land in, inside the firm's folder: sanitised
   * "<Name> <YYYY-MM-DD HH.mm>" in IST. The timestamp is what makes two people
   * called Ravi distinguishable; " 2", " 3" is appended if even that collides.
   */
  folderName String

  /**
   * sha256 of a secret the browser keeps. The link itself is a bearer token
   * anyone can forward, so it cannot identify a person — this is what says
   * "the same device that created this contributor is back". Hashed because the
   * row is read far more often than it is created, and a database leak should
   * not hand out the ability to upload as someone else.
   */
  secretHash String

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  /**
   * When an upload email last went out for this person. /api/uploads/notify
   * accepts link credentials, so the figures in its body are an anonymous
   * caller's claim and the route itself proves nothing was uploaded; a send is
   * claimed by moving this forward under a conditional update, and the next one
   * needs an Upload row newer than it. Mail to the firm is therefore bounded by
   * what actually arrived, not by how many times the endpoint is poked.
   */
  lastNotifiedAt DateTime?

  link    UploadLink    @relation(fields: [linkId], references: [id], onDelete: Cascade)
  uploads Upload[]
  folders MediaFolder[]

  @@index([linkId])
}

/// A folder that exists before anything is in it.
///
/// Folders are otherwise purely key prefixes (lib/uploadKey.ts), which means an
/// empty folder does not exist at all — fine while folders were only ever
/// derived from a drag-and-dropped directory, useless once someone can press
/// "New folder" and expect it to still be there. The gallery unions these rows
/// with the folders implied by the keys.
model MediaFolder {
  id      String @id @default(uuid())
  eventId String

  /**
   * Full path relative to the event, e.g. "Acme Studios/Ravi 2026-10-01 14.32/Day 1".
   */
  path String

  createdById   String?
  contributorId String?
  createdAt     DateTime @default(now())

  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("MediaFolderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  contributor UploadContributor? @relation(fields: [contributorId], references: [id], onDelete: SetNull)

  /**
   * Creating a folder twice is a no-op, not a second folder.
   */
  @@unique([eventId, path])
  /**
   * Both are read as filters: one person's folders for the per-contributor
   * breakdown, the firm's own for the main-account one.
   */
  @@index([contributorId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Research module (phase 1)
//
// A port of the standalone VelResearchTool pipeline. Every descriptive field on
// ResearchIdea is nullable on purpose: the extractor leaves a field null rather
// than guessing, and search filters are null-tolerant.
//
// The embedding column is pgvector and therefore Unsupported() here: it is read
// and written with parameterised $queryRaw / $executeRaw only.
// ---------------------------------------------------------------------------

enum ResearchSourceKind {
  reddit
  youtube
  rss
  clip
  web
}

enum ResearchPostStatus {
  new
  awaiting_comments
  skipped
  rejected
  extracted
  failed
}

enum ResearchIdeaStatus {
  active
  merged
  rejected
}

enum ResearchScopeCategory {
  activation
  marketing_activation
  crowd_engagement
  event_technology
  captivating_activity
}

enum ResearchInteractionMode {
  one_to_one
  one_to_many
  many_to_many
  self_guided
}

enum ResearchSetting {
  indoor
  outdoor
  hybrid
  virtual
}

enum ResearchBudgetBand {
  low
  medium
  high
  premium
}

enum ResearchIntensity {
  low
  medium
  high
}

enum ResearchJobStatus {
  queued
  running
  done
  failed
}

enum ResearchJobStage {
  expanding
  web
  reddit
  processing
}

model ResearchSource {
  id              String             @id @default(uuid())
  kind            ResearchSourceKind
  identifier      String
  label           String?
  enabled         Boolean            @default(true)
  pollIntervalMin Int                @default(60)
  lastPolledAt    DateTime?
  // Set when Reddit answers 429/403: no request goes out until it passes.
  backoffUntil    DateTime?
  settings        Json?
  createdAt       DateTime           @default(now())

  posts ResearchPost[]

  @@unique([kind, identifier])
}

model ResearchPost {
  id          String             @id @default(uuid())
  sourceId    String?
  kind        ResearchSourceKind
  externalId  String
  url         String?
  author      String?
  title       String?
  body        String?
  comments    Json?
  mediaUrls   Json?
  engagement  Json?
  postedAt    DateTime?
  fetchedAt   DateTime           @default(now())
  status      ResearchPostStatus @default(new)
  triage      Json?
  extraction  Json?
  error       String?
  processedAt DateTime?

  source    ResearchSource?      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ideaLinks ResearchIdeaSource[]
  jobLinks  ResearchJobPost[]

  @@unique([kind, externalId])
  @@index([status])
  @@index([sourceId])
}

model ResearchIdea {
  id                    String                      @id @default(uuid())
  scopeCategory         ResearchScopeCategory?
  title                 String?
  summary               String?
  howItWorks            String?
  eventTypes            String[]
  formats               String[]
  interactionMode       ResearchInteractionMode?
  audienceMin           Int?
  audienceMax           Int?
  minutesPerParticipant Decimal?
  totalDurationMinutes  Decimal?
  setting               ResearchSetting?
  spaceRequirements     String?
  techRequirements      String?
  staffing              String?
  staffCount            Int?
  setupTimeMinutes      Decimal?
  materials             String?
  budgetBand            ResearchBudgetBand?
  budgetNotes           String?
  audienceTypes         String[]
  ageGroup              String?
  brandable             Boolean?
  physicalIntensity     ResearchIntensity?
  region                String?
  occasion              String?
  tags                  String[]
  attributes            Json?
  confidence            Json?
  // vector(768); an HNSW cosine index lives in sql/research_module.sql.
  embedding             Unsupported("vector(768)")?
  popularityScore       Decimal                     @default(0)
  sourceCount           Int                         @default(0)
  firstSeenAt           DateTime?
  lastSeenAt            DateTime?
  status                ResearchIdeaStatus          @default(active)
  mergedIntoId          String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  sources    ResearchIdeaSource[]
  jobLinks   ResearchJobIdea[]
  mergedInto ResearchIdea?        @relation("ResearchIdeaMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom ResearchIdea[]       @relation("ResearchIdeaMerge")

  @@index([status])
  @@index([scopeCategory])
  @@index([eventTypes(ops: ArrayOps)], type: Gin)
  @@index([tags(ops: ArrayOps)], type: Gin)
}

model ResearchIdeaSource {
  ideaId          String
  postId          String
  extractionIndex Int      @default(0)
  createdAt       DateTime @default(now())

  idea ResearchIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  post ResearchPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([ideaId, postId, extractionIndex])
  @@index([postId])
}

model ResearchSearch {
  id            String   @id @default(uuid())
  needText      String?
  filters       Json?
  resultIdeaIds Json?
  answer        String?
  userId        String?
  createdAt     DateTime @default(now())

  jobs ResearchJob[]

  @@index([createdAt])
}

model ResearchJob {
  id         String            @id @default(uuid())
  needText   String?
  filters    Json?
  searchId   String?
  status     ResearchJobStatus @default(queued)
  stage      ResearchJobStage?
  stats      Json?
  // Stepper bookkeeping: which queries / urls / posts are still outstanding.
  state      Json?
  error      String?
  userId     String?
  // Held by the tick that is advancing this job; older than 3 minutes is stale.
  lockedAt   DateTime?
  createdAt  DateTime          @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  search ResearchSearch?   @relation(fields: [searchId], references: [id], onDelete: SetNull)
  posts  ResearchJobPost[]
  ideas  ResearchJobIdea[]

  @@index([status])
  @@index([createdAt])
}

model ResearchJobPost {
  jobId     String
  postId    String
  createdAt DateTime @default(now())

  job  ResearchJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  post ResearchPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([jobId, postId])
  @@index([postId])
}

model ResearchJobIdea {
  jobId     String
  ideaId    String
  created   Boolean  @default(true)
  createdAt DateTime @default(now())

  job  ResearchJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  idea ResearchIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@id([jobId, ideaId])
  @@index([ideaId])
}
