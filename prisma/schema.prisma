generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  MANAGING_DIRECTOR
  HEAD_OF_OPERATIONS
  HEAD_OF_SPECIAL_PROJECTS
  GROWTH_PARTNER
  OPERATIONS_TEAM_MEMBER
  RESEARCH_AND_DEVELOPMENT_TEAM_MEMBER
  INTERN
  ASSISTANT
  FREELANCER
  ACCOUNTANT
  PHOTOGRAPHER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum PaymentMode {
  CREDIT_CARD
  DEBIT_CARD
  UPI
  NOTA
}

enum Phase {
  IDEATION
  PITCHING
  BIDDING
  PREPARATION
  ONGOING
  FINISHED
}

model User {
  id          String   @id @default(uuid())
  uid         String   @unique
  name        String
  email       String   @unique
  passwordHash String
  designation String
  role        RoleName
  team        String?
  avatarUrl   String?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  onboardedVendors Vendor[]  @relation("VendorOnboardedBy")
  onboardedArtists Artist[]  @relation("ArtistOnboardedBy")
  assignedTasks    Task[]    @relation("TaskAssignedBy")
  receivedTasks    Task[]    @relation("TaskAssignedTo")
  ratings          Rating[]
  sessions         Session[]
  expenseClaims    ExpenseClaim[]
  uploads          Upload[]
  eventTeamMembers EventTeamMember[] @relation("EventTeamMembers")
  bdCalls          BdCall[]          @relation("BdCallAddedBy")
  notifications    Notification[]    @relation("NotificationActor")
  assignedLeads    Lead[]            @relation("LeadAssignedTo")
  assignedDeals    Deal[]            @relation("DealAssignedTo")
  sanctions        EventSanction[]   @relation("UserSanctions")
  mediaShares      MediaShare[]      @relation("MediaShareCreatedBy")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Event {
  id              String   @id @default(uuid())
  companyName     String
  eventName       String
  pocName         String
  pocPhone        String
  phase           Phase    @default(IDEATION)
  fromDate        DateTime
  toDate          DateTime
  costSheetUrl    String?
  closingSheetUrl String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendors     EventVendor[]
  artists     EventArtist[]
  teamMembers EventTeamMember[]
  uploads     Upload[]
  claims      ExpenseClaim[]
  finances    EventVendorFinance[]
  sanctions   EventSanction[]
  shares      MediaShare[]
}

model Vendor {
  id           String   @id @default(uuid())
  companyName  String
  email        String?
  phone        String
  work         String
  location     String?
  gstin        String?
  panCard      String?
  pocName      String?
  status       Status   @default(INACTIVE)
  currentEvent String?
  onboardedAt  DateTime @default(now())
  onboardedBy  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  onboardedByUser User                @relation("VendorOnboardedBy", fields: [onboardedBy], references: [id])
  ratings         Rating[]
  events          EventVendor[]
  finances        EventVendorFinance[]
}

model Artist {
  id           String   @id @default(uuid())
  name         String
  phone        String
  category     String
  location     String?
  socialLink   String?
  status       Status   @default(INACTIVE)
  currentEvent String?
  lastEvent    String?
  onboardedAt  DateTime @default(now())
  onboardedBy  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  onboardedByUser User     @relation("ArtistOnboardedBy", fields: [onboardedBy], references: [id])
  ratings         Rating[]
  events          EventArtist[]
}

model Rating {
  id        String   @id @default(uuid())
  rating    Int
  remarks   String?
  createdAt DateTime @default(now())

  vendorId  String?
  artistId  String?
  userId    String

  vendor    Vendor?  @relation(fields: [vendorId], references: [id])
  artist    Artist?  @relation(fields: [artistId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model EventVendor {
  eventId  String
  vendorId String

  event  Event  @relation(fields: [eventId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@id([eventId, vendorId])
}

model EventVendorFinance {
  id            String      @id @default(uuid())
  eventId       String
  vendorId      String
  quotedAmount  Float       @default(0)
  advancePaid   Float       @default(0)
  totalPaid     Float       @default(0)
  closed        Boolean     @default(false)
  paymentMode   PaymentMode @default(NOTA)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  event   Event  @relation(fields: [eventId], references: [id])
  vendor  Vendor @relation(fields: [vendorId], references: [id])

  @@unique([eventId, vendorId])
}

model EventSanction {
  id               String   @id @default(uuid())
  eventId          String
  userId           String
  sanctionedAmount Float    @default(0)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation("UserSanctions", fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model EventArtist {
  eventId  String
  artistId String

  event  Event  @relation(fields: [eventId], references: [id])
  artist Artist @relation(fields: [artistId], references: [id])

  @@id([eventId, artistId])
}

model EventTeamMember {
  eventId String
  userId  String

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation("EventTeamMembers", fields: [userId], references: [id])

  @@id([eventId, userId])
}

model ExpenseClaim {
  id         String         @id @default(uuid())
  userId     String
  eventId    String?
  status     Status         @default(INACTIVE)
  submittedAt DateTime      @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user       User           @relation(fields: [userId], references: [id])
  event      Event?         @relation(fields: [eventId], references: [id])
  items      ExpenseItem[]
  attachments ExpenseAttachment[]
}

model ExpenseItem {
  id        String   @id @default(uuid())
  claimId   String
  eventName String
  location  String
  type      String
  date      DateTime
  amount    Float

  claim     ExpenseClaim @relation(fields: [claimId], references: [id])
}

model ExpenseAttachment {
  id        String   @id @default(uuid())
  claimId   String
  fileUrl   String
  fileType  String
  createdAt DateTime @default(now())

  claim     ExpenseClaim @relation(fields: [claimId], references: [id])
}

model Upload {
  id        String   @id @default(uuid())
  eventId   String
  fileUrl   String
  fileType  String
  uploadedBy String
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [uploadedBy], references: [id])
}

model Task {
  id         String   @id @default(uuid())
  title      String
  notes      String?
  dueDate    DateTime?
  assignedBy String
  assignedTo String
  createdAt  DateTime @default(now())

  assignedByUser User @relation("TaskAssignedBy", fields: [assignedBy], references: [id])
  assignedToUser User @relation("TaskAssignedTo", fields: [assignedTo], references: [id])
}

enum BdStatus {
  FOLLOWUP
  LEAD
  DORMANT
  ACTIVE
}

model BdCall {
  id          String   @id @default(uuid())
  company     String
  pocName     String
  pocPhone    String
  pocEmail    String?
  callDate    DateTime
  remarks     String?
  status      BdStatus @default(ACTIVE)
  addedBy     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  addedByUser User @relation("BdCallAddedBy", fields: [addedBy], references: [id])
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  COLD_CALL
  EVENT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
}

enum DealStage {
  QUALIFICATION
  NEEDS_ANALYSIS
  VALUE_PROPOSITION
  IDENTIFY_DECISION_MAKERS
  PROPOSAL_PRICE_QUOTE
  NEGOTIATION_REVIEW
  CLOSED_WON
  CLOSED_LOST
}

model Lead {
  id          String     @id @default(uuid())
  name        String
  company     String
  email       String?
  phone       String?
  address     String?
  source      LeadSource @default(OTHER)
  status      LeadStatus @default(NEW)
  notes       String?
  assignedTo  String?
  createdBy   String
  convertedDealId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assignedToUser User? @relation("LeadAssignedTo", fields: [assignedTo], references: [id])
}

model SalesContact {
  id          String   @id @default(uuid())
  name        String
  email       String?
  phone       String?
  company     String?
  designation String?
  accountId   String?
  notes       String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account? @relation(fields: [accountId], references: [id])
}

model Account {
  id          String   @id @default(uuid())
  companyName String
  industry    String?
  phone       String?
  email       String?
  website     String?
  address     String?
  notes       String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts SalesContact[]
  deals    Deal[]
}

model Deal {
  id                String    @id @default(uuid())
  dealName          String
  accountId         String?
  stage             DealStage @default(QUALIFICATION)
  amount            Float     @default(0)
  expectedCloseDate DateTime?
  notes             String?
  assignedTo        String?
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  account        Account? @relation(fields: [accountId], references: [id])
  assignedToUser User?    @relation("DealAssignedTo", fields: [assignedTo], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  body      String
  actorId   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  actor User @relation("NotificationActor", fields: [actorId], references: [id])
}

/// A client delivery link. Tokens stay self-verifying, but recording them here
/// is what makes them listable, revocable, and countable — without this, staff
/// cannot see an existing link and simply mint another.
model MediaShare {
  id           String    @id @default(uuid())
  eventId      String
  folder       String?
  token        String    @unique
  createdBy    String
  expiresAt    DateTime
  revokedAt    DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  remindedAt   DateTime?
  createdAt    DateTime  @default(now())

  event   Event @relation(fields: [eventId], references: [id])
  creator User  @relation("MediaShareCreatedBy", fields: [createdBy], references: [id])

  @@index([eventId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Research module (phase 1)
//
// A port of the standalone VelResearchTool pipeline. Every descriptive field on
// ResearchIdea is nullable on purpose: the extractor leaves a field null rather
// than guessing, and search filters are null-tolerant.
//
// The embedding column is pgvector and therefore Unsupported() here: it is read
// and written with parameterised $queryRaw / $executeRaw only.
// ---------------------------------------------------------------------------

enum ResearchSourceKind {
  reddit
  youtube
  rss
  clip
  web
}

enum ResearchPostStatus {
  new
  awaiting_comments
  skipped
  rejected
  extracted
  failed
}

enum ResearchIdeaStatus {
  active
  merged
  rejected
}

enum ResearchScopeCategory {
  activation
  marketing_activation
  crowd_engagement
  event_technology
  captivating_activity
}

enum ResearchInteractionMode {
  one_to_one
  one_to_many
  many_to_many
  self_guided
}

enum ResearchSetting {
  indoor
  outdoor
  hybrid
  virtual
}

enum ResearchBudgetBand {
  low
  medium
  high
  premium
}

enum ResearchIntensity {
  low
  medium
  high
}

enum ResearchJobStatus {
  queued
  running
  done
  failed
}

enum ResearchJobStage {
  expanding
  web
  reddit
  processing
}

model ResearchSource {
  id              String             @id @default(uuid())
  kind            ResearchSourceKind
  identifier      String
  label           String?
  enabled         Boolean            @default(true)
  pollIntervalMin Int                @default(60)
  lastPolledAt    DateTime?
  // Set when Reddit answers 429/403: no request goes out until it passes.
  backoffUntil    DateTime?
  settings        Json?
  createdAt       DateTime           @default(now())

  posts ResearchPost[]

  @@unique([kind, identifier])
}

model ResearchPost {
  id          String             @id @default(uuid())
  sourceId    String?
  kind        ResearchSourceKind
  externalId  String
  url         String?
  author      String?
  title       String?
  body        String?
  comments    Json?
  mediaUrls   Json?
  engagement  Json?
  postedAt    DateTime?
  fetchedAt   DateTime           @default(now())
  status      ResearchPostStatus @default(new)
  triage      Json?
  extraction  Json?
  error       String?
  processedAt DateTime?

  source    ResearchSource?      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ideaLinks ResearchIdeaSource[]
  jobLinks  ResearchJobPost[]

  @@unique([kind, externalId])
  @@index([status])
  @@index([sourceId])
}

model ResearchIdea {
  id                    String                      @id @default(uuid())
  scopeCategory         ResearchScopeCategory?
  title                 String?
  summary               String?
  howItWorks            String?
  eventTypes            String[]
  formats               String[]
  interactionMode       ResearchInteractionMode?
  audienceMin           Int?
  audienceMax           Int?
  minutesPerParticipant Decimal?
  totalDurationMinutes  Decimal?
  setting               ResearchSetting?
  spaceRequirements     String?
  techRequirements      String?
  staffing              String?
  staffCount            Int?
  setupTimeMinutes      Decimal?
  materials             String?
  budgetBand            ResearchBudgetBand?
  budgetNotes           String?
  audienceTypes         String[]
  ageGroup              String?
  brandable             Boolean?
  physicalIntensity     ResearchIntensity?
  region                String?
  occasion              String?
  tags                  String[]
  attributes            Json?
  confidence            Json?
  // vector(768); an HNSW cosine index lives in sql/research_module.sql.
  embedding             Unsupported("vector(768)")?
  popularityScore       Decimal                     @default(0)
  sourceCount           Int                         @default(0)
  firstSeenAt           DateTime?
  lastSeenAt            DateTime?
  status                ResearchIdeaStatus          @default(active)
  mergedIntoId          String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  sources    ResearchIdeaSource[]
  jobLinks   ResearchJobIdea[]
  mergedInto ResearchIdea?        @relation("ResearchIdeaMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom ResearchIdea[]       @relation("ResearchIdeaMerge")

  @@index([status])
  @@index([scopeCategory])
  @@index([eventTypes(ops: ArrayOps)], type: Gin)
  @@index([tags(ops: ArrayOps)], type: Gin)
}

model ResearchIdeaSource {
  ideaId          String
  postId          String
  extractionIndex Int      @default(0)
  createdAt       DateTime @default(now())

  idea ResearchIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  post ResearchPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([ideaId, postId, extractionIndex])
  @@index([postId])
}

model ResearchSearch {
  id            String   @id @default(uuid())
  needText      String?
  filters       Json?
  resultIdeaIds Json?
  answer        String?
  userId        String?
  createdAt     DateTime @default(now())

  jobs ResearchJob[]

  @@index([createdAt])
}

model ResearchJob {
  id         String            @id @default(uuid())
  needText   String?
  filters    Json?
  searchId   String?
  status     ResearchJobStatus @default(queued)
  stage      ResearchJobStage?
  stats      Json?
  // Stepper bookkeeping: which queries / urls / posts are still outstanding.
  state      Json?
  error      String?
  userId     String?
  // Held by the tick that is advancing this job; older than 3 minutes is stale.
  lockedAt   DateTime?
  createdAt  DateTime          @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  search ResearchSearch?   @relation(fields: [searchId], references: [id], onDelete: SetNull)
  posts  ResearchJobPost[]
  ideas  ResearchJobIdea[]

  @@index([status])
  @@index([createdAt])
}

model ResearchJobPost {
  jobId     String
  postId    String
  createdAt DateTime @default(now())

  job  ResearchJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  post ResearchPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([jobId, postId])
  @@index([postId])
}

model ResearchJobIdea {
  jobId     String
  ideaId    String
  created   Boolean  @default(true)
  createdAt DateTime @default(now())

  job  ResearchJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  idea ResearchIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@id([jobId, ideaId])
  @@index([ideaId])
}
